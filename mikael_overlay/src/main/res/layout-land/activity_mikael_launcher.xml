<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mikael_root" android:layout_width="match_parent" android:layout_height="match_parent">
<ImageView android:id="@+id/mikael_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:alpha="0.28" android:src="@drawable/bg_mikael_gradient"/>
<View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_mikael_overlay"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="22dp" android:weightSum="4.9">

<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.05" android:orientation="vertical" android:paddingEnd="14dp">
<LinearLayout android:id="@+id/account_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/card_mikael" android:padding="16dp">
<ImageView android:id="@+id/account_avatar" android:layout_width="60dp" android:layout_height="60dp" android:src="@drawable/ic_mikael_logo" android:scaleType="centerCrop"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="12dp">
<TextView android:id="@+id/account_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nenhuma conta" android:textColor="@color/mikael_text_primary" android:textSize="18sp" android:textStyle="bold"/>
<TextView android:id="@+id/account_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conta" android:textColor="@color/mikael_text_secondary" android:textSize="12sp"/>
</LinearLayout></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PERFIL ATUAL" android:textColor="@color/mikael_text_secondary" android:textSize="11sp" android:textStyle="bold" android:layout_marginTop="22dp"/>
<TextView android:id="@+id/selected_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Minecraft latest_release" android:textColor="@color/mikael_text_primary" android:textSize="16sp" android:layout_marginTop="6dp"/>
<TextView android:id="@+id/java_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Java automático" android:textColor="@color/mikael_text_secondary" android:textSize="13sp" android:layout_marginTop="6dp"/>
<TextView android:id="@+id/ram_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="RAM 2048 MB" android:textColor="@color/mikael_text_secondary" android:textSize="13sp" android:layout_marginTop="4dp"/>
<Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
<TextView android:id="@+id/storage_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Livre: --" android:textColor="@color/mikael_text_secondary" android:textSize="12sp"/>
<TextView android:id="@+id/install_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Instalação: --" android:textColor="@color/mikael_text_secondary" android:textSize="12sp" android:layout_marginTop="3dp"/>
</LinearLayout>

<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2.05" android:orientation="vertical" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="MIKAEL LAUNCHER" android:textColor="@color/mikael_accent" android:textStyle="bold" android:textSize="13sp" android:letterSpacing="0.16"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minecraft Java Edition" android:textColor="@color/mikael_text_primary" android:textStyle="bold" android:textSize="28sp" android:layout_marginTop="6dp"/>
<TextView android:id="@+id/load_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pronto para jogar" android:textColor="@color/mikael_text_secondary" android:textSize="12sp" android:layout_marginTop="10dp"/>
<ProgressBar android:id="@+id/launch_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="7dp" android:max="100" android:visibility="gone" android:layout_marginTop="10dp"/>
<Button android:id="@+id/play_button" android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="18dp" android:background="@drawable/button_mikael_play" android:text="JOGAR" android:textAllCaps="false" android:textColor="@color/mikael_button_text" android:textSize="22sp" android:textStyle="bold" android:elevation="8dp"/>
<Button android:id="@+id/installed_versions_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/button_mikael_nav" android:text="📦  Versões" android:textAllCaps="false" android:textColor="@color/mikael_text_primary" android:textSize="16sp"/>
<Button android:id="@+id/configure_version_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/button_mikael_nav" android:text="⚙️  Configurar versão" android:textAllCaps="false" android:textColor="@color/mikael_text_primary" android:textSize="16sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Minecraft • perfil configurável • memória configurável" android:textColor="@color/mikael_text_secondary" android:textSize="12sp" android:layout_marginTop="10dp"/>
<TextView android:id="@+id/launcher_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Launcher ativo" android:textColor="@color/mikael_accent_soft" android:textSize="11sp" android:layout_marginTop="12dp"/>
</LinearLayout>

<LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.8" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="14dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NAVEGAÇÃO" android:textColor="@color/mikael_text_secondary" android:textSize="11sp" android:textStyle="bold" android:paddingBottom="8dp"/>
<Button android:id="@+id/nav_home" android:layout_width="match_parent" android:layout_height="42dp" android:text="🏠  Início" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
<Button android:id="@+id/nav_play" android:layout_width="match_parent" android:layout_height="42dp" android:text="🎮  Jogar" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
<Button android:id="@+id/nav_versions" android:layout_width="match_parent" android:layout_height="42dp" android:text="📦  Versões" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
<Button android:id="@+id/nav_mods" android:layout_width="match_parent" android:layout_height="42dp" android:text="🧩  Mods" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
<Button android:id="@+id/nav_accounts" android:layout_width="match_parent" android:layout_height="42dp" android:text="👤  Contas" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
<Button android:id="@+id/nav_java" android:layout_width="match_parent" android:layout_height="42dp" android:text="☕  Java" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
<Button android:id="@+id/nav_settings" android:layout_width="match_parent" android:layout_height="42dp" android:text="⚙  Configurações" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
<Button android:id="@+id/nav_files" android:layout_width="match_parent" android:layout_height="42dp" android:text="📁  Arquivos" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
<Button android:id="@+id/nav_logs" android:layout_width="match_parent" android:layout_height="42dp" android:text="📋  Logs" android:background="@drawable/button_mikael_nav" android:textColor="@color/mikael_text_primary" android:textAllCaps="false"/>
</LinearLayout></LinearLayout></FrameLayout>